programa {
  funcao inicio() {

    cadeia nome
    real valor

    escreva("Qual o nome do produto? \n")
    leia(nome)

    escreva( "Qual o valor do produto? \n")
    leia(valor)

    escreva( nome," custa R$",valor, "\n")
    
  }
}
