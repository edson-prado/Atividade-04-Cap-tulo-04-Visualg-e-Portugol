programa {
  funcao inicio() {
  
  cadeia nome
  inteiro idade
  inteiro salario

  escreva("Qual seu nome? \n")
  leia(nome)

  escreva("Qual sua idade? \n")
  leia(idade)
  
  escreva("Qual o seu salário? \n")
  leia(salario)

  escreva("---Cadastro--- \n")
  escreva("Nome:",nome, "\n")
  escreva("Idade:",idade, "\n")
  escreva("Salário:R$",salario, ",00\n")
    
  }
}
